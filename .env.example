# RAVIN ARRAY: public HTTPS service URL (never put secrets in VITE_*).
# By default, ARRAY uses the existing Render service:
# https://ravin-hyeq.onrender.com
# This override is only needed if the backend service URL changes.
# VITE_RAVIN_ARRAY_API_URL=https://your-new-ravin-service.example

# Main chat shortcut.
VITE_RAVIN_CHAT_URL=https://enterarrow.com/ravin
